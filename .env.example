NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Transaction pooler (6543): server only. URL-encode the password, without placeholder brackets.
DATABASE_URL=postgresql://postgres.PROJECT:ENCODED_PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true
# Session pooler (5432): used by migration, import and administrator seed scripts.
DIRECT_URL=postgresql://postgres.PROJECT:ENCODED_PASSWORD@POOLER_HOST:5432/postgres
# Supabase public CA is bundled and included in the Vercel build.
# DATABASE_SSL_CA_PATH=database/certs/supabase-ca.crt
# Exact public origin. Set this to your Vercel domain before production.
# APP_ORIGIN=https://your-project.vercel.app
ALLOW_REGISTRATION=true
